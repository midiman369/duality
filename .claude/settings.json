{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/backup_workdata.py\" --hook 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/backup_workdata.py\" --hook --force 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
